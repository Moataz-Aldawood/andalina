{
  "name": "andalina-builder",
  "displayName": "Andalina Builder",
  "description": "The official VS Code extension for building Andalina UI projects into static HTML.",
  "version": "1.6.0",
  "publisher": "moataz-aldawood",
  "license": "LGPL-3.0-or-later",
  "icon": "logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Moataz-Aldawood/andalina"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:**/*.html"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "andalinaExplorer",
          "title": "Andalina",
          "icon": "$(zap)"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "andalinaTargets",
          "name": "Andalina Build"
        }
      ]
    },
    "commands": [
      {
        "command": "andalina.buildTarget",
        "title": "Build Action",
        "icon": "$(play)"
      },
      {
        "command": "andalina.editTarget",
        "title": "Edit Action",
        "icon": "$(edit)"
      },
      {
        "command": "andalina.deleteTarget",
        "title": "Delete Action",
        "icon": "$(trash)"
      },
      {
        "command": "andalina.addTarget",
        "title": "Add New Action",
        "icon": "$(add)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "andalina.addTarget",
          "when": "view == andalinaTargets",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "andalina.buildTarget",
          "when": "view == andalinaTargets && viewItem == buildTarget",
          "group": "inline@1"
        },
        {
          "command": "andalina.editTarget",
          "when": "view == andalinaTargets && viewItem == buildTarget",
          "group": "inline@2"
        },
        {
          "command": "andalina.deleteTarget",
          "when": "view == andalinaTargets && viewItem == buildTarget",
          "group": "inline@3"
        }
      ]
    },
    "configuration": {
      "title": "Andalina Builder",
      "properties": {
        "andalinaBuilder.targets": {
          "type": "array",
          "description": "Array of build targets.",
          "default": [],
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Friendly name for the build target."
              },
              "src": {
                "type": "string",
                "description": "Absolute or relative path to the source folder."
              },
              "dest": {
                "type": "string",
                "description": "Absolute or relative path to the destination folder."
              },
              "clearBeforeBuild": {
                "type": "boolean",
                "description": "Whether to delete the destination folder before building.",
                "default": false
              },
              "autoBuild": {
                "type": "boolean",
                "description": "Automatically trigger an Andalina build when saving any .html file.",
                "default": false
              }
            }
          }
        }
      }
    }
  },
  "dependencies": {
    "builder": "file:../builder"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "esbuild": "^0.28.2",
    "vsce": "^2.15.0"
  },
  "scripts": {
    "vscode:prepublish": "npm run esbuild-base -- --minify",
    "esbuild-base": "node -e \"const fs=require('fs'); fs.mkdirSync('dist', {recursive:true}); fs.copyFileSync('../core/andalina.js', 'dist/andalina-core.js')\" && esbuild ./src/extension.js --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "build": "npm run esbuild-base -- --sourcemap",
    "package": "npm run vscode:prepublish && npx vsce package --no-dependencies"
  }
}