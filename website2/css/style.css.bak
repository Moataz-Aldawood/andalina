/* =========================================
   1. VARIABLES & ROOT
========================================= */
:root {
  /* Approved Andalina Colors */
  --bg-main: #FDE6C3;
  --color-main-1: #4C4743;
  --color-main-2: #F97C4B;
  --color-main-3: #FFB200;
  --color-main-4: #C3A279;

  /* Natural Colors */
  --gray-dark: #767171;
  --gray-light: #A5A5A5;
  --white: #FFFBEC;
  --black: #000000;

  /* Other Colors: */

  --blue-dark: #4472C4;
  --blue-light: #5B9BD5;
  --green: #70AD47;
}

@import url("https://fonts.googleapis.com/css?family=Montserrat:300,400,500,600,700,800&display=swap");

/* =========================================
   2. RESET & BASE TYPOGRAPHY
========================================= */
body {
  font-family: "Montserrat", sans-serif;
  -webkit-font-smoothing: antialiased;
  font-size: 16px;
  line-height: 1.6;
  background-color: var(--color-main-1) !important;
  color: var(--color-main-1);
  overflow-x: hidden;
}

h1,
h2,
h3,
h4,
h5,
h6 {
  color: var(--color-main-1);
  font-family: "Montserrat", sans-serif;
  font-weight: 700;
  line-height: 1.2;
}

dt {
  font-weight: 700;
}

dd {
  margin-bottom: 0.5rem;
  margin-left: 0 !important;
}

html {
  overflow-x: initial !important;
  overflow-y: initial !important;
}

img {
  vertical-align: middle;
  border: 0;
  max-width: 100%;
  height: auto;
}

ul {
  list-style: none;
}

a {
  color: inherit;
}

a,
a:hover,
a:focus {
  text-decoration: none;
}

a,
button,
select {
  cursor: pointer;
  transition: 0.2s ease;
}

a:focus,
button:focus,
select:focus {
  outline: 0;
}

a:hover {
  color: var(--color-main-2);
}

body,
button,
input,
select,
textarea {
  font-family: "Montserrat", sans-serif;
}

pre {
  position: relative;
}

html,
body {
  color: var(--color-main-1) !important;
}

hr {
  background-color: var(--gray-dark) !important;
  border: none !important;
  height: 1px !important;
  opacity: 0.5;
  /* Slight transparency so it isn't too harsh */
}

/* =========================================
   3. LAYOUT & GRID
========================================= */
.section {
  padding-top: 80px;
  padding-bottom: 80px;
  padding-left: 0;
  padding-right: 0;
}

.section-sm {
  padding-top: 50px;
  padding-bottom: 50px;
}

.section-title {
  margin-bottom: 40px;
}

.container {
  padding-left: 15px;
  padding-right: 15px;
}

.column {
  padding: 15px;
}

.columns {
  margin-left: -15px;
  margin-right: -15px;
  margin-top: -15px;
}

.columns:last-child {
  margin-bottom: -15px;
}

.bg-light,
.section {
  background-color: transparent !important;
}

/* =========================================
   4. COMPONENTS
========================================= */
p,
.paragraph {
  font-weight: 400;
  color: var(--color-main-1);
  font-size: 16px;
  line-height: 26px;
  font-family: "Montserrat", sans-serif;
  margin-bottom: 1rem;
}

h1,
.h1 {
  font-size: 50px;
  font-weight: 800;
}

h2,
.h2 {
  font-size: 42px;
  font-weight: 800;
}

h3,
.h3 {
  font-size: 32px;
}

h4,
.h4 {
  font-size: 26px;
}

h5,
.h5 {
  font-size: 22px;
}

h6,
.h6 {
  font-size: 18px;
}

.btn {
  font-size: 16px;
  font-family: "Montserrat", sans-serif;
  text-transform: capitalize;
  padding: 13px 30px;
  border-radius: 6px;
  border: 1px solid;
  position: relative;
  z-index: 1;
  transition: 0.2s ease;
  font-weight: 600;
  display: inline-block;
}

.btn:hover,
.btn:active,
.btn:focus {
  outline: 0;
}

.btn-sm {
  font-size: 14px;
  padding: 10px 25px;
}

.btn-primary {
  background: var(--color-main-2);
  color: var(--white);
  border-color: var(--white);
}

.btn-primary:active,
.btn-primary:hover,
.btn-primary:focus,
.btn-primary.focus,
.btn-primary.active {
  color: var(--white);
  background: var(--color-main-2) !important;
  border-color: var(--color-main-2) !important;
}

.btn-outline-primary {
  background: transparent;
  color: var(--color-main-2);
  border-color: var(--color-main-2);
}

.btn-outline-primary:active,
.btn-outline-primary:hover,
.btn-outline-primary:focus,
.btn-outline-primary.focus,
.btn-outline-primary.active {
  background: var(--color-main-2) !important;
  border-color: var(--color-main-2) !important;
  color: var(--white);
}

::-moz-selection {
  background: var(--color-main-2);
  color: var(--white);
}

::selection {
  background: var(--color-main-2);
  color: var(--white);
}

.border-default {
  border-color: var(--gray-light) !important;
}

.rounded,
.card-icon,
.card {
  border-radius: 12px !important;
}

.shadow,
.card,
.search-wrapper .input,
.navigation.nav-bg {}

.list-inline {
  padding-left: 0;
  list-style: none;
}

.list-inline .list-inline-item {
  display: inline-block;
}

.list-inline .list-inline-item:not(:last-child) {
  margin-right: 0.5rem;
}

.border-0 {
  border: 0;
}

.border {
  border: 1px solid var(--white) !important;
}

.border-bottom {
  border-bottom: 1px solid var(--white) !important;
}

.border-left {
  border-left: 1px solid var(--white) !important;
}

.border-0 {
  border: 0 !important;
}

.navigation {
  transition: 0.2s ease;
  padding: 15px 0;
}

.navbar-item {
  text-transform: capitalize;
  color: var(--color-main-1);
}

.navbar-item:focus,
.navbar-item:hover {
  background-color: transparent !important;
  color: var(--color-main-2) !important;
}

.navbar-brand {
  align-items: center;
}

.navbar-brand img {
  max-height: initial;
}

.navbar-start .navbar-item {
  padding-left: 20px;
  padding-right: 20px;
}

.is-sticky-top {
  position: -webkit-sticky;
  position: sticky;
  top: 0;
  z-index: 9997;
}

.navbar-burger {
  color: var(--black);
  height: 2.7rem;
  width: 2.7rem;
  border: 1px solid var(--gray-light);
  background-color: var(--white);
  border-radius: 2px;
  top: 5px;
}

.navbar-burger:hover {
  background-color: var(--white);
}

.search-wrapper {
  position: relative;
}

.search-wrapper .input {
  height: 46px;
  border: 0;
  outline: 0;
  padding-left: 17px;
}

.search-wrapper .input::-moz-placeholder {
  color: var(--gray-light);
  font-size: 15px;
}

.search-wrapper .input::placeholder {
  color: var(--gray-light);
  font-size: 15px;
}

.search-wrapper button {
  position: absolute;
  right: 5px;
  top: 50%;
  transform: translateY(-50%);
}

.search-wrapper button i {
  color: var(--color-main-2);
}

.card {
  transition: 0.2s ease;
  border: 0;
}

.card-icon {
  background: var(--color-main-2);
  color: var(--white);
  height: 55px;
  width: 60px;
  line-height: 55px;
  text-align: center;
  font-size: 27px;
  display: block;
  margin-top: 40px;
}

.card-text {
  margin-bottom: 0;
}

.card-title {
  font-weight: 700;
  margin-bottom: 0.75rem;
}

.card-body {
  padding: 25px;
}

.card:hover {}

.social-icons {
  margin-bottom: 0;
}

.social-icons a {
  display: block;
  height: 42px;
  width: 42px;
  line-height: 42px;
  text-align: center;
  color: var(--white);
  background: var(--color-main-2);
  border-radius: 6px;
}

.footer-menu {
  margin-bottom: 0;
}

.footer-menu a {
  display: block;
  padding: 10px;
  color: var(--color-main-1);
  transition: 0.2s ease;
}

.footer-menu a:hover {
  color: var(--color-main-2);
}

.sidenav {
  border-right: 2px solid var(--color-main-2);
  padding-right: 20px;
  padding-left: 30px;
}

.sidenav ul {
  padding-left: 10px;
}

.sidenav>li a {
  padding: 12px 0;
  color: var(--color-main-1);
  display: block;
  font-size: 18px;
  font-weight: bold;
}

.sidenav>li:not(:last-child) {
  border-bottom: 1px solid var(--color-main-2);
}

.sidenav .sidelist ul {
  display: none;
}

.sidenav .parent>a {
  color: var(--color-main-2) !important;
  position: relative;
  margin-left: 10px;
}

.sidenav .parent>a::before {
  position: absolute;
  content: "";
  left: -10px;
  top: 25%;
  height: 50%;
  width: 1px;
  background: var(--color-main-2);
}

.sidenav .parent ul {
  display: block;
  margin-bottom: 10px;
}

.sidenav .parent ul a {
  padding: 5px 0;
  font-size: 14px;
  font-weight: 400;
  color: var(--color-main-2);
}

.sidenav .parent ul li.active>a {
  margin-left: 10px;
}

.sidenav .parent ul li.active>a::before {
  height: 5px;
  width: 5px;
  border-radius: 50%;
  display: block;
  top: 13px;
}

.pagination {
  margin-top: 50px;
  justify-content: space-between;
}

.pagination a {
  color: var(--color-main-2);
  font-size: 18px;
  font-weight: 500;
}

.pagination i {
  line-height: 1.6;
}

.code-tabs {
  border: 1px solid var(--gray-light);
  overflow: hidden;
  margin-bottom: 20px;
}

.code-tabs .nav-tabs {
  margin-bottom: 0;
}

.code-tabs .tab-content {
  padding: 20px 15px;
}

pre .copy-to-clipboard {
  background: var(--color-main-2);
  color: var(--white);
  cursor: pointer;
  padding: 4px 5px;
  line-height: 1;
  font-size: 12px;
  font-weight: 500;
  border-radius: 4px;
  position: absolute;
  right: 10px;
  top: 10px;
}

:not(pre)>code+span.copy-to-clipboard {
  display: none;
}

.form-group label {
  font-size: 15px;
  font-weight: 500;
}

.form-group .input {
  height: 40px;
  background: transparent;
  border: 0;
  border-bottom: 1px solid var(--gray-light);
  border-radius: 0;
  padding: 10px 0;
}

.form-group .input::-moz-placeholder {
  font-size: 13px;
  color: var(--gray-light);
}

.form-group .input::placeholder {
  font-size: 13px;
  color: var(--gray-light);
}

.form-group .input:focus {
  outline: 0;
  border-color: var(--color-main-2);
}

.form-group .custom-select {
  font-size: 13px;
  color: var(--gray-light);
}

.form-group textarea.input {
  height: 100px;
}

.badge {
  margin-bottom: 20px;
  font-weight: 500;
  font-size: 15px;
  padding: 5px 10px;
}

.badge.added {
  background: var(--blue-dark);
  color: var(--white);
}

.badge.fixed {
  background: var(--unapproved-color-9);
  color: var(--white);
}

.badge.changed {
  background: var(--green);
  color: var(--white);
}

.badge.depricated {
  background: var(--white0);
  color: var(--white);
}

.badge.removed {
  background: var(--blue-light);
  color: var(--white);
}

.badge.security {
  background: var(--white1);
  color: var(--white);
}

.badge.unreleased {
  background: var(--white2);
  color: var(--white);
}

.collapse-wrapper {
  padding: 5px 15px;
}

.collapse-wrapper .collapse-head {
  text-decoration: none;
  color: var(--color-main-1);
  font-size: 18px;
  font-weight: 500;
  align-items: center;
}

:not(.highlight) pre {
  background: var(--white3);
}

.content h1,
.content h2,
.content h3,
.content h4,
.content h5,
.content h6 {
  font-weight: 500;
}

.content strong {
  font-weight: 600;
}

.content a {
  text-decoration: underline;
  color: var(--color-main-2);
}

.content ol,
.content ul {
  padding-left: 20px;
  margin-left: 0;
}

.content ol li,
.content ul li {
  margin-bottom: 10px;
}

.content ul {
  list-style: none;
  padding-left: 0;
  margin-bottom: 20px;
}

.content ul li {
  padding-left: 20px;
  position: relative;
}

.content ul li::before {
  position: absolute;
  content: "";
  height: 8px;
  width: 8px;
  border-radius: 50%;
  background: var(--color-main-2);
  left: 3px;
  top: 8px;
}

.content table {
  width: 100%;
  max-width: 100%;
  margin-bottom: 1rem;
  border: 1px solid var(--gray-light);
}

.content table td,
.content table th {
  padding: 0.75rem;
  vertical-align: top;
  margin-bottom: 0;
}

.content tr:not(:last-child) {
  border-bottom: 1px solid var(--gray-light);
}

.content th {
  font-weight: 500;
}

.content thead {
  background: var(--white3);
  margin-bottom: 0;
}

.content thead tr {
  border-bottom: 1px solid var(--gray-light);
}

.content tbody {
  background: var(--white);
  margin-bottom: 0;
}

.content .notices {
  margin: 2rem 0;
  position: relative;
  overflow: hidden;
}

.content .notices p {
  padding: 10px;
  margin-bottom: 0;
}

.content .notices p::before {
  position: absolute;
  top: 2px;
  color: var(--white);
  font-family: "themify";
  font-weight: 900;
  content: "\e717";
  left: 10px;
}

.content .notices.note p {
  border-top: 30px solid var(--white4);
  background: var(--white5);
}

.content .notices.note p::after {
  content: "Note";
  position: absolute;
  top: 2px;
  color: var(--white);
  left: 2rem;
}

.content .notices.tip p {
  border-top: 30px solid var(--white6);
  background: var(--white7);
}

.content .notices.tip p::after {
  content: "Tip";
  position: absolute;
  top: 2px;
  color: var(--white);
  left: 2rem;
}

.content .notices.info p {
  border-top: 30px solid var(--white8);
  background: var(--white9);
}

.content .notices.info p::after {
  content: "Info";
  position: absolute;
  top: 2px;
  color: var(--white);
  left: 2rem;
}

.content .notices.warning p {
  border-top: 30px solid var(--color-main-2);
  background: var(--color-main-2);
}

.content .notices.warning p::after {
  content: "Warning";
  position: absolute;
  top: 2px;
  color: var(--white);
  left: 2rem;
}

.content blockquote {
  font-size: 20px !important;
  color: var(--color-main-1);
  padding: 20px 40px;
  border-left: 2px solid var(--color-main-2);
  margin: 40px 0;
  font-weight: bold;
  background: var(--white3);
}

.content blockquote p {
  margin-bottom: 0 !important;
}



.content code {
  margin-bottom: 0 !important;
  font-size: 100%;
}

.code-tabs {
  overflow: hidden;
  margin-bottom: 20px;
  background-color: var(--white);
}

.code-tabs .tab-pane {
  display: none;
}

.code-tabs .tab-pane.active {
  display: block;
}

.code-tabs .nav-tabs {
  list-style: none;
  margin: 0 !important;
}

.code-tabs .nav-tabs li {
  padding: 0 !important;
  margin: 0 !important;
}

.code-tabs .nav-tabs li::before {
  display: none;
}

.code-tabs .nav-tabs li a {
  border-radius: 0 !important;
  text-decoration: none;
}

.code-tabs .nav-tabs li a:focus {
  border-color: var(--color-main-2);
}

.code-tabs .nav-tabs li.active a {
  color: var(--white);
  background-color: var(--color-main-2);
  border-color: var(--color-main-2);
}

.code-tabs .tab-content {
  padding: 20px 15px;
  border: 1px solid var(--gray-light);
}

.no-pointer {
  pointer-events: none;
}

.content a {
  text-decoration: underline;
  color: var(--color-main-2);
}

.content ol,
.content ul {
  padding-left: 20px;
  margin-left: 0;
}

.content ol li,
.content ul li {
  margin-bottom: 10px;
}

.content ul {
  list-style: none;
  padding-left: 0;
  margin-bottom: 20px;
}

.content ul li {
  padding-left: 20px;
  position: relative;
}

.content ul li::before {
