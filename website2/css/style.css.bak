  border-top: 30px solid var(--white8);
  background: var(--white);
}

.content .notices.info p::after {
  content: "Info";
  position: absolute;
  top: 2px;
  color: var(--white);
  left: 2rem;
}

.content .notices.warning p {
  border-top: 30px solid var(--color-main-2);
  background: var(--white);
}

.content .notices.warning p::after {
  content: "Warning";
  position: absolute;
  top: 2px;
  color: var(--white);
  left: 2rem;
}

.content blockquote {
  font-size: 20px !important;
  color: var(--color-main-1);
  padding: 20px 40px;
  border-left: 2px solid var(--color-main-2);
  margin: 40px 0;
  font-weight: bold;
  background: var(--white3);
}

.content blockquote p {
  margin-bottom: 0 !important;
}



.content code {
  margin-bottom: 0 !important;
  font-size: 100%;
}

.code-tabs {
  overflow: hidden;
  margin-bottom: 20px;
  background-color: var(--white);
}

.code-tabs .tab-pane {
  display: none;
}

.code-tabs .tab-pane.active {
  display: block;
}

.code-tabs .nav-tabs {
  list-style: none;
  margin: 0 !important;
}

.code-tabs .nav-tabs li {
  padding: 0 !important;
  margin: 0 !important;
}

.code-tabs .nav-tabs li::before {
  display: none;
}

.code-tabs .nav-tabs li a {
  border-radius: 0 !important;
  text-decoration: none;
}

.code-tabs .nav-tabs li a:focus {
  border-color: var(--color-main-2);
}

.code-tabs .nav-tabs li.active a {
  color: var(--white);
  background-color: var(--color-main-2);
  border-color: var(--color-main-2);
}

.code-tabs .tab-content {
  padding: 20px 15px;
  border: 1px solid var(--gray-light);
}

.no-pointer {
  pointer-events: none;
}

.shadow-hover:hover {
  transform: translateY(-5px);
}

h1,
h2,
h3,
h4,
h5,
h6,
.title {
  color: var(--color-main-2) !important;
}

.btn-outline-primary {
  border-color: var(--color-main-2) !important;
  color: var(--color-main-2) !important;
}

.btn-outline-primary:hover {
  background-color: var(--color-main-2) !important;
  color: var(--white) !important;
}

.andalina-content {
  background-color: var(--bg-main) !important;
  border-radius: 1.5rem !important;
  max-width: 1100px !important;
  margin-left: auto !important;
  margin-right: auto !important;
}

.navbar,
.navigation {
  background-color: var(--bg-main) !important;
  border-bottom: 4px solid var(--color-main-2) !important;
}

.navbar-item:hover,
.navigation a:hover {
  color: var(--color-main-1) !important;
}





.content :not(pre)>code,
:not(pre)>code {

  background-color: var(--color-main-1) !important;
  color: var(--bg-main) !important;
  padding: 3px 6px !important;
  border-radius: 4px !important;
  font-family: Consolas, Monaco, 'Courier New', monospace !important;
  font-size: 0.9em !important;
  font-weight: 600 !important;
  border: 1px solid var(--gray-dark) !important;
}

.navbar-start .navbar-item {
  /* font-size: 1.25rem !important; */
  font-weight: 600 !important;
}

.btn {
  padding: 0.75rem 1.5rem !important;
  border-radius: 8px !important;
  font-weight: 600 !important;
  font-size: 1rem !important;
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  transition: all 0.3s ease !important;
}

.btn-sm {
  padding: 0.5rem 1rem !important;
  font-size: 0.9rem !important;
}

.btn-primary {
  background-color: var(--color-main-2) !important;
  border: 2px solid var(--color-main-2) !important;
  color: var(--bg-main) !important;
}

.btn-primary:hover {
  background-color: var(--color-main-2) !important;
  border-color: var(--color-main-2) !important;
  transform: translateY(-2px);
}

.btn-outline-primary {
  background-color: transparent !important;
  border: 2px solid var(--color-main-2) !important;
  color: var(--color-main-2) !important;
}

.btn-outline-primary:hover {
  background-color: var(--color-main-2) !important;
  color: var(--bg-main) !important;
  transform: translateY(-2px);
}

.card {
  background-color: var(--white3) !important;
  border: 1px solid var(--gray-dark) !important;
  border-radius: 12px !important;
}

.card-icon {
  pointer-events: none;
}

.shadow-hover:hover {
  transform: translateY(-5px);
}

h1,
h2,
h3,
h4,
h5,
h6,
.title {
  color: var(--color-main-2) !important;
}

.btn-outline-primary {
  border-color: var(--color-main-2) !important;
  color: var(--color-main-2) !important;
}

.btn-outline-primary:hover {
  background-color: var(--color-main-2) !important;
  color: var(--white) !important;
}

.navbar-item:hover,
.navigation a:hover {
  color: var(--color-main-1) !important;
}





.content :not(pre)>code,
:not(pre)>code {
  background-color: var(--color-main-4) !important;
  color: var(--color-main-1) !important;
  padding: 3px 6px !important;
  border-radius: 4px !important;
  font-family: Consolas, Monaco, 'Courier New', monospace !important;
  font-size: 0.9em !important;
  font-weight: 600 !important;
  border: 0px !important;

}

.navbar-start .navbar-item {
  /* font-size: 1.25rem !important; */
  font-weight: 600 !important;
}

.btn {
  padding: 0.75rem 1.5rem !important;
  border-radius: 8px !important;
  font-weight: 600 !important;
  font-size: 1rem !important;
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  transition: all 0.3s ease !important;
}

.btn-sm {
  padding: 0.5rem 1rem !important;
  font-size: 0.9rem !important;
}

.btn-primary {
  background-color: var(--color-main-2) !important;
  border: 2px solid var(--color-main-2) !important;
  color: var(--bg-main) !important;
}

.btn-primary:hover {
  background-color: var(--color-main-2) !important;
  border-color: var(--color-main-2) !important;
  transform: translateY(-2px);
}

.btn-outline-primary {
  background-color: transparent !important;
  border: 2px solid var(--color-main-2) !important;
  color: var(--color-main-2) !important;
}

.btn-outline-primary:hover {
  background-color: var(--color-main-2) !important;
  color: var(--bg-main) !important;
  transform: translateY(-2px);
}

.card {
  background-color: var(--white3) !important;
  border: 1px solid var(--gray-dark) !important;
  border-radius: 12px !important;
}

.card-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 70px;
  height: 70px;
  background: var(--gray-dark);
  border-radius: 50%;
  color: var(--color-main-2) !important;
}

.content h3 {
  font-size: 1.8rem !important;
  color: #4C4743 !important;
  font-weight: 700 !important;
  margin-top: 4rem !important; /* Big space before parts */
  border-bottom: 2px solid #ED6C44 !important;
  padding-bottom: 0.5rem !important;
  margin-bottom: 1.5rem !important;
  width: fit-content !important;
}

.content h4 {
  font-size: 1.4rem !important;
  color: #ED6C44 !important;
  font-weight: 600 !important;
  padding-left: 0.5rem !important;
  margin-top: 2rem !important; /* Smaller space before subtitles */
  margin-bottom: 0.35rem !important; /* Tiny space after subtitles */
}

.content p {
  margin-bottom: 1.25rem !important; /* Logical space between paragraphs */
  line-height: 1.7 !important;
}

.content ul {
  padding-left: 2.5rem !important;
  margin-top: 1rem !important;
  margin-bottom: 1rem !important;
}

.content ul li {
  margin-bottom: 0.75rem !important;
  position: relative;
  list-style-type: none !important;
  padding-left: 0.5rem;
}

.content ul li::before {
  content: "";
  position: absolute;
  left: -0.8rem;
  top: 0.55rem;
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background-color: var(--color-main-1) !important;
}

.andalina-important-card {
  background-color: var(--white) !important;
  border: 2px solid var(--color-main-2) !important;
  border-radius: 12px !important;
  padding: 1.5rem 2rem !important;
  color: var(--color-main-1) !important;
  position: relative;
  overflow: hidden;
  margin: 2rem 0 !important;
}

.andalina-important-card strong {
  color: var(--color-main-2) !important;
  font-size: 1.1em;
}

.sidenav .an-prefix {
  color: #ED6C44 !important;
}

.sidenav .an-tag {
  color: #4C4743 !important;
}

/* =========================================
   5. UTILITIES & HELPERS
========================================= */
.preloader {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: var(--white);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.text-primary {
  color: var(--color-main-2) !important;
}

.text-light {
  color: var(--gray-light) !important;
}

.has-text-weight-medium {
  font-weight: 500;
}

.ml-auto {
  margin-left: auto;
}

.bg-white {
  background-color: var(--white);
}

p,
.paragraph,
.content p,
.has-text-grey {
  color: var(--color-main-1) !important;
}

.has-text-primary {
  color: var(--color-main-2) !important;
}

p,
.paragraph,
.content p,
.has-text-grey {
  color: var(--color-main-1) !important;
}

.has-text-primary {
  color: var(--color-main-2) !important;
}

/* =========================================
   6. MEDIA QUERIES (RESPONSIVE)
========================================= */
@media (max-width: 575px) {

  h1,
  .h1 {
    font-size: 36px;
    font-weight: 600;
  }
}

@media (max-width: 575px) {

  h2,
  .h2 {
    font-size: 32px;
    font-weight: 600;
  }
}

@media (max-width: 575px) {

  h3,
  .h3 {
    font-size: 28px;
  }
}

@media screen and (min-width: 1216px) {
  .container:not(.is-max-desktop) {
    max-width: 1140px;
  }
}

@media (max-width: 1023px) {
  .container {
    max-width: 765px;
  }
}

@media (max-width: 768px) {
  .container {
    max-width: 540px;
  }
}

@media (max-width: 1023px) {
  .navbar-brand .navbar-item {
    padding-left: 0;
  }
}

@media (max-width: 1023px) {
  .navbar-menu {
    padding: 1.5rem 0;
    text-align: center;
  }

  .navbar-end {
    margin: 12px 0 2px;
  }

  .navbar-end .btn {
    margin-left: 5px !important;
    margin-right: 5px !important;
    margin-top: 5px;
  }

  .hide-on-desktop {
    display: none;
  }

  .show-on-desktop {
    display: block !important;
    margin-top: 20px;
  }
}

@media (max-width: 768px) {
  .andalina-content {
    padding: 1.5rem !important;
  }
}
.content p + pre {
  margin-top: -0.75rem !important;
}

